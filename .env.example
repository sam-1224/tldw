# ─────────────────────────────────────────────────────────────
# TL;DW environment (all optional)
#
# You do NOT have to set anything here. Users can enter their own
# keys in the browser (BYOK). Set keys here only if you want the
# server to provide a default key for everyone who uses your instance.
# A key sent from the browser always overrides the matching value here.
# ─────────────────────────────────────────────────────────────

# Pick ONE LLM provider's key (whichever you'll use by default).
# Cheapest free tiers: GEMINI or GROQ.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional. Only used as a fallback when a video has no captions.
# Free tier: 100 requests/month at https://supadata.ai
SUPADATA_API_KEY=
