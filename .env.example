# ─────────────────────────────────────────────────────────────
# TL;DW environment (all optional)
#
# FREE MODE: set at least one key below from a free tier and every
# visitor gets keyless summaries — zero friction. Recommended:
#   GEMINI_API_KEY  — free at https://aistudio.google.com (no card,
#                     ~1,500 req/day on gemini-2.5-flash)
# Optional extra free capacity (failover on rate limits):
#   GROQ_API_KEY     — free at https://console.groq.com
#   CEREBRAS_API_KEY — free at https://cloud.cerebras.ai
#
# BYOK: a key sent from the browser always overrides these and is
# used only for that request. Nothing here is required.
# ─────────────────────────────────────────────────────────────

# Free-mode chain (tried in order gemini -> groq -> cerebras)
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=

# Which provider keyless requests try first (default: gemini)
DEFAULT_PROVIDER=

# Other supported BYOK providers (env fallback works for these too)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Optional. Only used as a fallback when a video has no captions.
# Free tier: 100 requests/month at https://supadata.ai
SUPADATA_API_KEY=
